# This file is a placeholder for environment variables required to run this project.

# Password for protected pages/routes
PAGE_ACCESS_PASSWORD=password

# Admin panel (/admin) auth — separate from PAGE_ACCESS_PASSWORD above
ADMIN_PASSWORD=change_me
ADMIN_SESSION_SECRET=generate_a_long_random_string_here

# Neon Postgres (auto-provisioned via `vercel integration add neon`, then `vercel env pull`)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Vercel Blob (auto-provisioned via `vercel blob create-store`, then `vercel env pull`)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token_here
